{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "assessment", "operations", "beforeAfter"],
  "properties": {
    "schemaVersion": {"const": 1},
    "summary": {"type": "string", "maxLength": 800},
    "assessment": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "verdict", "reason"],
        "properties": {
          "point": {"type": "string", "maxLength": 300},
          "verdict": {"enum": ["일치", "보완", "수정 필요", "모순"]},
          "reason": {"type": "string", "maxLength": 400}
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "target", "text", "why"],
        "properties": {
          "op": {"enum": ["ADD_RULE", "UPDATE_RULE", "DELETE_RULE", "ADD_PRINCIPLE", "UPDATE_PRINCIPLE", "DELETE_PRINCIPLE"]},
          "target": {"type": "string", "maxLength": 20},
          "text": {"type": ["string", "null"], "maxLength": 300},
          "why": {"type": "string", "maxLength": 400}
        }
      }
    },
    "beforeAfter": {"type": "string", "maxLength": 1500}
  }
}
